# Optional. The frontend calls a relative "/api" path by default, which works
# automatically in dev (Vite proxy, see vite.config.ts) and in production
# (Express serves the built frontend + API from the same origin).
# Only set this if you deploy the frontend and backend on different domains
# and wire it into src/lib/api.ts yourself.
# VITE_API_BASE_URL=https://api.example.com
